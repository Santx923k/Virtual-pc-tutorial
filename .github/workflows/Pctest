name: PC Virtual Gratis

on: 
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest

    steps:
    - name: Configurar Acesso RDP
      run: |
        Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server' -Name "fDenyTSConnections" -Value 0
        Enable-NetFirewallRule -DisplayGroup "Remote Desktop"
        
    - name: Criar Usuario e Senha
      run: |
        net user Administrador SenhaSegura123# /add
        net localgroup Administrators Administrador /add
        
    - name: Inicializar Conexao
      run: |
        write-host "Aguardando conexao externa..."
